#include <windows.h>

#define IDI_WASIO_PLAYER 1
IDI_WASIO_PLAYER ICON "../../src/icons/wasio_player.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "wasio-player"
            VALUE "FileDescription",  "wasio-player - Bit-Perfect Audio Player (WASAPI & ASIO)"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "WasioPlayer"
            VALUE "LegalCopyright",   "Copyright (C) 2026"
            VALUE "OriginalFilename", "WasioPlayer.exe"
            VALUE "ProductName",      "wasio-player"
            VALUE "ProductVersion",   "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
