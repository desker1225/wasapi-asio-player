#include <windows.h>

// Generated by CMake from src/version.h.in; see CMakeLists.txt for the version
// and product name.
#include "version.h"

#define IDI_WASIO_PLAYER 1
IDI_WASIO_PLAYER ICON "../../src/icons/wasio_player.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     WASIO_VERSION_MAJOR,WASIO_VERSION_MINOR,WASIO_VERSION_PATCH,WASIO_VERSION_BUILD
PRODUCTVERSION  WASIO_VERSION_MAJOR,WASIO_VERSION_MINOR,WASIO_VERSION_PATCH,WASIO_VERSION_BUILD
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      WASIO_APP_NAME
            VALUE "FileDescription",  WASIO_APP_DESCRIPTION
            VALUE "FileVersion",      WASIO_VERSION_STRING_FULL
            VALUE "InternalName",     "WasioPlayer"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Desker Chuo"
            VALUE "OriginalFilename", "WasioPlayer.exe"
            VALUE "ProductName",      WASIO_APP_NAME
            VALUE "ProductVersion",   WASIO_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
